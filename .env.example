# JWT & Admin Credentials for /admin portal
JWT_SECRET="replace-with-strong-random-secret"
ADMIN_EMAIL="admin@himalayanarabicabeans.com"
ADMIN_PASSWORD="change-this-admin-password"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional: comma-separated list of extra origins allowed to call the API.
# In production, leave APP_URL / CORS_ALLOWED_ORIGINS set to your real domain.
CORS_ALLOWED_ORIGINS=""
PORT=3000

# PostgreSQL connection (required: the API now reads/writes PostgreSQL via Prisma)
DB_NAME="himalayan_arabica_beans"
DB_USER="postgres"
DB_PASSWORD="change-this-postgres-password"
DB_HOST="localhost"
DB_PORT=5432
DATABASE_URL="postgresql://postgres:change-this-postgres-password@localhost:5432/himalayan_arabica_beans?schema=public"

# Optional: used by docker-compose to initialise the bundled PostgreSQL service
POSTGRES_USER="himalayan"
POSTGRES_PASSWORD="change-this-postgres-password"
POSTGRES_DB="himalayan_arabica_beans"
